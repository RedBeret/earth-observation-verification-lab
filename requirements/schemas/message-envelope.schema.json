{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/terrawatch/schemas/message-envelope-1.0.0.json",
  "title": "TerraWatch versioned message envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "event_type",
    "occurred_at",
    "aggregate_id",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": ["imagery.ingested", "telemetry.accepted"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,7}$",
      "maxLength": 96
    },
    "payload": {
      "type": "object",
      "minProperties": 2
    }
  }
}
