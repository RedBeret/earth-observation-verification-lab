{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/terrawatch/schemas/test-procedure-1.0.0.json",
  "title": "Executable TerraWatch test procedure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "purpose",
    "requirement_references",
    "preconditions",
    "inputs",
    "steps",
    "expected_observations",
    "pass_fail_criteria",
    "cleanup",
    "evidence_locations",
    "troubleshooting"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^TP-[A-Z]{3}-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "requirement_references": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" }
    },
    "preconditions": { "$ref": "#/$defs/nonEmptyStrings" },
    "inputs": { "$ref": "#/$defs/nonEmptyStrings" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "action": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expected_observations": { "$ref": "#/$defs/nonEmptyStrings" },
    "pass_fail_criteria": { "$ref": "#/$defs/nonEmptyStrings" },
    "cleanup": { "$ref": "#/$defs/nonEmptyStrings" },
    "evidence_locations": { "$ref": "#/$defs/nonEmptyStrings" },
    "troubleshooting": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
