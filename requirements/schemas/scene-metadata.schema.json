{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/terrawatch/schemas/scene-metadata-1.0.0.json",
  "title": "TerraWatch scene metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "source", "capture_time"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "scene_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,7}$",
      "maxLength": 96
    },
    "source": { "type": "string", "minLength": 1, "maxLength": 80 },
    "capture_time": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "declared_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
