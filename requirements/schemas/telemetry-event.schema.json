{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/terrawatch/schemas/telemetry-event-1.0.0.json",
  "title": "TerraWatch synthetic telemetry event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "observed_at",
    "location",
    "confidence",
    "source",
    "attributes"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,7}$",
      "maxLength": 96
    },
    "event_type": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "observed_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "type": "string", "minLength": 1, "maxLength": 80 },
    "attributes": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  }
}
